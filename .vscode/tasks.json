{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build float exercises",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-Wall",
        "-Wextra",
        "-g3",
        "Estructuras/float/Ejercicios_float.c",
        "-o",
        "Estructuras/float/output/Ejercicios_float",
        "-lm"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
